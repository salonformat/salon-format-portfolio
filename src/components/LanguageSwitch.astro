---
import type { Language } from '../i18n/translations';
const { lang = 'en' } = Astro.props as { lang?: Language };
const path = Astro.url.pathname.replace(/^\/(de|fr)(?=\/|$)/, '') || '/';
const route = (next: Language) => next === 'en' ? path : `/${next}${path === '/' ? '/' : path}`;
---
<nav class="language-switch" aria-label={lang === 'de' ? 'Sprache wählen' : lang === 'fr' ? 'Choisir la langue' : 'Choose language'}>
  <a href={route('en')} lang="en" hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
  <a href={route('de')} lang="de" hreflang="de" aria-current={lang === 'de' ? 'page' : undefined}>DE</a>
  <a href={route('fr')} lang="fr" hreflang="fr" aria-current={lang === 'fr' ? 'page' : undefined}>FR</a>
</nav>

<style is:global>
  .language-switch{display:flex;align-items:center;gap:.55rem;margin-left:.7rem;font-family:var(--sans);font-size:.62rem;font-weight:500;letter-spacing:.08em;line-height:1;text-transform:uppercase}
  .language-switch a{position:relative;padding:.7rem .12rem .55rem;color:inherit;text-decoration:none}
  .language-switch a::after{content:"";position:absolute;right:.1rem;bottom:.28rem;left:.1rem;height:1px;background:currentColor;opacity:0;transform:scaleX(.35);transition:opacity .18s ease,transform .18s ease}
  .language-switch a:hover::after,.language-switch a:focus-visible::after,.language-switch a[aria-current="page"]::after{opacity:1;transform:scaleX(1)}
  .case-header .language-switch{margin-left:auto}
  .case-header>.language-switch+a{margin-left:0}
  @media(max-width:800px){
    .site-header{gap:.7rem}
    .site-header>.language-switch{margin-left:auto}
    .site-header nav:not(.language-switch){order:3;width:100%;justify-content:flex-end}
    .language-switch a{min-width:2.15rem;min-height:2.75rem;display:grid;place-items:center;padding:.45rem 0}
    .case-header{gap:.65rem}
    .case-header .language-switch{margin-left:auto}
    .case-header>a:not(.case-home){display:none}
  }
</style>
