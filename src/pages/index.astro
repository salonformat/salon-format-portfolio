---
import '@fontsource/della-respira';
import '@fontsource/josefin-sans/400.css';
import '@fontsource/josefin-sans/500.css';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Salon Format — interactive learning experiences by Isabella Kohout." />
    <link rel="icon" type="image/png" href={`${base}brand/salon-format-mark.png`} />
    <title>Salon Format — Learning Experience Design</title>
  </head>
  <body>
    <!--
    THESIS: A learning portfolio that begins with a person, not a platform, and refuses the standard white project-grid hero.
    OWN-WORLD: Cobalt-blue studio field, flat modular color sections, Della Respira, Josefin Sans, and Isabella's illustration as the connective tissue.
    STORY: Meet Salon Format, see learner-centred work in action, understand Isabella's combined practice, then start a conversation.
    FIRST VIEWPORT: Wordmark and learner-first claim sit left; an abstract learning sequence connects colored forms on the right; the yellow featured project rises into the bottom edge as the primary onward action.
    FORM: Contemporary Learning Salon, grounded candidate 6, seed 229794fb.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <header class="site-header">
      <a class="mark-link" href="#top" aria-label="Salon Format home">
        <img src={`${base}brand/salon-format-mark.png`} alt="" />
      </a>
      <nav aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <img class="wordmark" src={`${base}brand/salon-format-wordmark-only.png`} alt="Salon Format" />
          <h1 id="hero-title">Learning through design, story and play.</h1>
        </div>
        <div class="learning-motion" role="button" tabindex="0" aria-label="Bring the shapes together">
          <svg viewBox="0 0 760 620" role="presentation" aria-hidden="true">
            <path class="motion-shape motion-shape-one" d="M93 119C143 53 258 56 291 126C323 195 268 275 183 271C95 267 42 187 93 119Z" />
            <path class="motion-shape motion-shape-two" d="M443 81C523 45 622 91 636 174C649 253 572 301 497 267C424 233 367 116 443 81Z" />
            <path class="motion-shape motion-shape-three" d="M288 345C346 297 441 318 471 380C502 446 449 523 363 515C278 508 229 394 288 345Z" />
            <image class="motion-mark" href={`${base}brand/salon-format-mark.png`} x="312" y="218" width="138" height="138" />
            <text class="motion-title" x="380" y="520" text-anchor="middle">An idea</text>
            <text class="motion-subtitle" x="380" y="553" text-anchor="middle">takes shape.</text>
          </svg>
        </div>
        <a class="scroll-cue" href="#projects" aria-label="Continue to featured project">
          <span></span>
        </a>
      </section>

      <section class="projects-intro" id="projects" aria-labelledby="projects-title">
        <h2 id="projects-title">Projects</h2>
        <p>A selection of projects across interactive learning, art, culture and education.</p>
      </section>

      <section class="elio-project" aria-labelledby="elio-title">
        <div class="elio-copy">
          <p class="section-label">Featured project · 01</p>
          <p class="project-status">Interactive learning experience</p>
          <h2 id="elio-title">Elio’s Ocean<br /><em>Investigation</em></h2>
          <p class="elio-description">A child’s drawing becomes an illustrated investigation into how creatures live in the ocean.</p>
          <p class="project-meta">Inquiry-led learning · Visual storytelling · Ocean science</p>
          <div class="project-actions">
            <a class="text-link" href={`${base}projects/elios-ocean-investigation`}>View case study <span class="ui-arrow" aria-hidden="true"></span></a>
            <a class="text-link" href="https://salonformat.github.io/elios-ocean-investigation/en/" target="_blank" rel="noreferrer">Open the experience <span class="ui-arrow ui-arrow-external" aria-hidden="true"></span></a>
          </div>
        </div>
        <div class="elio-visual" aria-hidden="true">
          <img class="elio-ocean-backdrop" src={`${base}images/elio/ocean-collage.png`} alt="" />
          <span></span>
          <img src={`${base}images/elio/elios-wesen.png`} alt="" />
        </div>
      </section>

      <section class="kusama-project" aria-labelledby="kusama-title">
        <div class="kusama-copy">
          <p class="section-label">Project 02</p>
          <p class="project-status">Working prototype</p>
          <h2 id="kusama-title">Into<br /><em>the Infinite</em></h2>
          <p class="kusama-description">A small interactive homage to Yayoi Kusama, built around repetition, sound and personal response.</p>
          <p class="project-meta">Cultural learning · Interaction · Reflection</p>
          <div class="project-actions">
            <a class="text-link" href={`${base}projects/into-the-infinite`}>View case study <span class="ui-arrow" aria-hidden="true"></span></a>
            <a class="text-link" href="https://salonformat.github.io/museum-experience-kusama/" target="_blank" rel="noreferrer">Open the experience <span class="ui-arrow ui-arrow-external" aria-hidden="true"></span></a>
          </div>
        </div>
        <div class="kusama-visual" aria-hidden="true">
          <span class="kusama-dot dot-one"></span>
          <span class="kusama-dot dot-two"></span>
          <span class="kusama-dot dot-three"></span>
          <img src={`${base}images/kusama/figure.png`} alt="" />
        </div>
      </section>

      <section class="emilie-project" aria-labelledby="emilie-title">
        <div class="emilie-copy">
          <p class="section-label">Project 03</p>
          <p class="project-status">Work in progress · Working prototype</p>
          <h2 id="emilie-title">Emilie Flöge:<br /><em>Movement Through Fabric</em></h2>
          <p class="emilie-description">A digital museum prototype about clothing, movement and Emilie Flöge’s work.</p>
          <p class="project-meta">Cultural learning · Interactive storytelling · Experience design</p>
          <div class="project-actions">
            <a class="text-link" href={`${base}projects/emilie-floege`}>View case study <span class="ui-arrow" aria-hidden="true"></span></a>
            <a class="text-link subtle-link" href="https://salonformat.github.io/emilie-bewegung-aus-stoff/" target="_blank" rel="noreferrer">Experience the prototype <span class="ui-arrow ui-arrow-external" aria-hidden="true"></span></a>
          </div>
        </div>
        <div class="emilie-visual" aria-hidden="true">
          <span class="emilie-orbit"></span>
          <img src={`${base}images/emilie/figure.png`} alt="" />
          <p>How much space does your clothing allow?</p>
        </div>
      </section>

      <section class="featured" aria-labelledby="featured-title">
        <div class="featured-copy">
          <p class="section-label">Project 04</p>
          <h2 id="featured-title">Learning,<br />Differently</h2>
          <p class="featured-description">A short interactive course about designing for a learner’s real situation.</p>
          <p class="project-meta">Inclusive learning · Learner context · Accessibility</p>
          <div class="project-actions">
            <a class="text-link" href={`${base}projects/learning-differently`}>View case study <span class="ui-arrow" aria-hidden="true"></span></a>
            <a class="text-link" href="https://getlarge.github.io/learning-differently/" target="_blank" rel="noreferrer">Open the experience <span class="ui-arrow ui-arrow-external" aria-hidden="true"></span></a>
          </div>
        </div>
        <div class="featured-preview" id="project-preview">
          <img src={`${base}images/learning-differently-preview.png`} alt="Learning, Differently interface showing Anna's train journey" />
        </div>
      </section>

      <section class="practice-transition" aria-labelledby="practice-transition-title">
        <h2 id="practice-transition-title">About<br />Salon Format</h2>
        <p>Salon Format brings together learning design, visual communication and playful interaction.</p>
      </section>

      <section class="practice" aria-labelledby="practice-title">
        <div class="practice-intro">
          <p class="section-label">What we do</p>
          <h2 id="practice-title">Learning, design and interaction.</h2>
        </div>
        <div class="practice-grid">
          <article class="practice-item learning">
            <h3>Learning</h3>
            <p>Learning experiences shaped around people, context and access.</p>
          </article>
          <article class="practice-item design">
            <h3>Design</h3>
            <p>Visual systems and illustration that help explain and organise ideas.</p>
          </article>
          <article class="practice-item experience">
            <h3>Experience</h3>
            <p>Interaction that gives people something useful to try, notice or change.</p>
          </article>
        </div>
      </section>

      <section class="about" id="about" aria-labelledby="about-title">
        <div class="about-heading">
          <h2 id="about-title">About</h2>
          <p>I’m Isabella, a designer, art educator and learning experience designer based in Vienna.</p>
        </div>
        <figure class="about-portrait">
          <img src={`${base}images/about/isabella-kohout.jpg`} alt="Portrait of Isabella Kohout" />
        </figure>
        <div class="about-copy">
          <div class="about-story">
            <p>I studied photography at die Graphische and Art Education at the University of Applied Arts Vienna. Along the way, I worked in film, architecture and editorial design, lived and worked in Austria and France, and eventually spent several years teaching art and design.</p>
            <p>Teaching changed the way I think about design. It made me interested in what happens after something looks good: whether people understand it, want to explore it, remember it, or feel invited to take part.</p>
            <p>Today, my work brings together graphic design, illustration, art, education, storytelling and digital interaction. I’m particularly interested in creating learning experiences that feel intuitive, visual and engaging — experiences people actually want to spend time with.</p>
          </div>
          <div class="about-salon">
            <h3>Salon Format</h3>
            <p>Salon Format is my independent practice for learning and experience design.</p>
            <p>I develop interactive courses, digital experiences, museum and cultural projects, and visual learning materials for adults and young people.</p>
            <p>The projects can take very different forms, but they share the same approach: making ideas easier to explore and understand through thoughtful design, interaction and storytelling.</p>
            <p>Salon Format is also a space for experimentation — bringing together illustration, technology, sound, movement and whatever else helps an idea come to life.</p>
          </div>
        </div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <img src={`${base}brand/salon-format-mark.png`} alt="" />
        <div>
          <p class="section-label">Start a conversation</p>
          <h2 id="contact-title">Would you like to work together?</h2>
          <a class="contact-email" href="mailto:bellakohout@gmail.com">bellakohout@gmail.com</a>
        </div>
      </section>
    </main>
    <script>
      const motion = document.querySelector('.learning-motion');
      if (motion) {
        const updateMotion = (active) => motion.toggleAttribute('data-paused', !active);
        const observer = new IntersectionObserver(([entry]) => updateMotion(entry.isIntersecting && !document.hidden), { threshold: 0.15 });
        observer.observe(motion);
        document.addEventListener('visibilitychange', () => updateMotion(!document.hidden));

        let gathering = false;
        const gatherIdea = () => {
          if (gathering || motion.hasAttribute('data-paused')) return;
          gathering = true;
          motion.setAttribute('data-gathering', '');

          const shapes = [
            [motion.querySelector('.motion-shape-one'), 'translate(108px, 78px) rotate(3deg) scale(.96)'],
            [motion.querySelector('.motion-shape-two'), 'translate(-108px, 80px) rotate(-2deg) scale(.96)'],
            [motion.querySelector('.motion-shape-three'), 'translate(0, -78px) rotate(-2deg) scale(.96)']
          ];
          const animations = shapes.map(([shape, target]) => {
            const start = getComputedStyle(shape).transform;
            return shape.animate(
              [
                { transform: start, offset: 0 },
                { transform: target, offset: .3 },
                { transform: target, offset: .68 },
                { transform: start, offset: 1 }
              ],
              { duration: 4200, easing: 'cubic-bezier(.45, 0, .2, 1)' }
            );
          });

          const reveal = (element, transform = 'translateY(0)') => element.animate(
            [
              { opacity: 0, transform, offset: 0 },
              { opacity: 1, transform, offset: .3 },
              { opacity: 1, transform, offset: .68 },
              { opacity: 0, transform, offset: 1 }
            ],
            { duration: 4200, easing: 'cubic-bezier(.45, 0, .2, 1)' }
          );
          animations.push(reveal(motion.querySelector('.motion-mark'), 'scale(.92)'));
          animations.push(reveal(motion.querySelector('.motion-title'), 'translateY(0)'));
          animations.push(reveal(motion.querySelector('.motion-subtitle'), 'translateY(0)'));

          window.setTimeout(() => {
            motion.removeAttribute('data-gathering');
            gathering = false;
          }, 4200);
        };

        motion.addEventListener('click', gatherIdea);
        motion.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            gatherIdea();
          }
        });
      }
    </script>
  </body>
</html>
