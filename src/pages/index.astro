---
import '@fontsource/della-respira';
import '@fontsource/josefin-sans/400.css';
import '@fontsource/josefin-sans/500.css';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Salon Format — interactive learning experiences by Isabella Kohout." />
    <link rel="icon" type="image/png" href={`${base}brand/salon-format-mark.png`} />
    <title>Salon Format — Learning Experience Design</title>
  </head>
  <body>
    <!--
    THESIS: A learning portfolio that begins with a person, not a platform, and refuses the standard white project-grid hero.
    OWN-WORLD: Cobalt-blue studio field, flat modular color sections, Della Respira, Josefin Sans, and Isabella's illustration as the connective tissue.
    STORY: Meet Salon Format, see learner-centred work in action, understand Isabella's combined practice, then start a conversation.
    FIRST VIEWPORT: Wordmark and learner-first claim sit left; an abstract learning sequence connects colored forms on the right; the yellow featured project rises into the bottom edge as the primary onward action.
    FORM: Contemporary Learning Salon, grounded candidate 6, seed 229794fb.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <header class="site-header">
      <a class="mark-link" href="#top" aria-label="Salon Format home">
        <img src={`${base}brand/salon-format-mark.png`} alt="" />
      </a>
      <nav aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <img class="wordmark" src={`${base}brand/salon-format-wordmark-only.png`} alt="Salon Format" />
          <h1 id="hero-title">Learning through design, story and play.</h1>
          <a class="hero-project-link" href="#projects">View projects <span aria-hidden="true">↓</span></a>
        </div>
        <div class="scratch-reveal" role="button" tabindex="0" aria-label="Scratch to reveal what Salon Format brings together">
          <div class="scratch-underlay" aria-hidden="true">
            <span>Learning</span>
            <span>Design</span>
            <span>Interaction</span>
          </div>
          <canvas class="scratch-canvas" aria-hidden="true"></canvas>
          <p class="scratch-prompt">Scratch to reveal</p>
        </div>
      </section>

      <section class="project-index" id="projects" aria-labelledby="projects-title">
        <header class="project-index-heading">
          <h2 id="projects-title">Projects</h2>
          <p>Interactive learning across art, culture, education and everyday life.</p>
        </header>

        <div class="project-mosaic">
          <article class="project-tile project-tile--elio">
            <div class="tile-copy">
              <p class="tile-number">01 · Inquiry-led learning</p>
              <h3><a class="tile-main-link" href={`${base}projects/elio`}>Elio’s Ocean<br /><em>Investigation</em></a></h3>
              <p>A child’s drawing becomes an ocean investigation.</p>
            </div>
            <div class="tile-art" aria-hidden="true">
              <img class="elio-tile-ocean" src={`${base}images/elio/ocean-collage.png`} alt="" />
              <img class="elio-tile-creature" src={`${base}images/elio/elios-wesen.png`} alt="" />
            </div>
            <a class="tile-experience" href="https://ocean.salonformat.com/en/" target="_blank" rel="noreferrer">Experience <span aria-hidden="true">↗</span></a>
          </article>

          <article class="project-tile project-tile--infinite">
            <div class="tile-copy">
              <p class="tile-number">02 · Cultural learning</p>
              <h3><a class="tile-main-link" href={`${base}projects/infinite`}>Into the <em>Infinite</em></a></h3>
              <p>An interactive introduction to repetition, perception and Yayoi Kusama’s artistic world.</p>
            </div>
            <div class="tile-art" aria-hidden="true"><img src={`${base}images/kusama/figure.png`} alt="" /></div>
            <a class="tile-experience" href="https://infinite.salonformat.com/" target="_blank" rel="noreferrer">Experience <span aria-hidden="true">↗</span></a>
          </article>

          <article class="project-tile project-tile--first-aid">
            <div class="tile-copy">
              <p class="tile-number">03 · Medical education</p>
              <h3><a class="tile-main-link" href={`${base}projects/first-aid`}>What if I <em>get it wrong?</em></a></h3>
              <p>A bilingual first-aid experience that makes room for uncertainty before practical training.</p>
            </div>
            <div class="tile-art" aria-hidden="true"><img src={`${base}images/first-aid/experience-preview.png`} alt="" /></div>
            <a class="tile-experience" href="https://firstaid.salonformat.com/" target="_blank" rel="noreferrer">Experience <span aria-hidden="true">↗</span></a>
          </article>

          <article class="project-tile project-tile--emilie">
            <div class="tile-copy">
              <p class="tile-number">04 · Museum prototype</p>
              <h3><a class="tile-main-link" href={`${base}projects/emilie`}>Emilie Flöge:<br /><em>Movement Through Fabric</em></a></h3>
              <p>A digital museum experience about clothing, movement and creative freedom.</p>
            </div>
            <div class="tile-art" aria-hidden="true"><img src={`${base}images/emilie/figure.png`} alt="" /></div>
            <a class="tile-experience" href="https://emilie.salonformat.com/?lang=en" target="_blank" rel="noreferrer">Experience <span aria-hidden="true">↗</span></a>
          </article>

          <article class="project-tile project-tile--learning">
            <div class="tile-copy">
              <p class="tile-number">05 · Inclusive design</p>
              <h3><a class="tile-main-link" href={`${base}projects/learning`}>Learning,<br /><em>Differently</em></a></h3>
              <p>A short course for designing around a learner’s real situation.</p>
            </div>
            <div class="tile-art" aria-hidden="true"><img src={`${base}images/learning-differently-preview.png`} alt="" /></div>
            <a class="tile-experience" href="https://getlarge.github.io/learning-differently/" target="_blank" rel="noreferrer">Experience <span aria-hidden="true">↗</span></a>
          </article>
        </div>

        <aside class="capabilities" aria-labelledby="capabilities-title">
          <h3 id="capabilities-title">What we do</h3>
          <ul>
            <li>Learning experience design</li>
            <li>Interactive courses</li>
            <li>Professional learning &amp; development</li>
            <li>Learning for young audiences</li>
            <li>Museum &amp; cultural experiences</li>
            <li>Illustration &amp; visual storytelling</li>
          </ul>
        </aside>
      </section>

      <section class="about" id="about" aria-labelledby="about-title">
        <div class="about-heading">
          <p class="section-label">Studio &amp; practice</p>
          <h2 id="about-title">About</h2>
          <p>I’m Isabella, a designer, art educator and learning experience designer based in Vienna.</p>
        </div>
        <figure class="about-portrait">
          <img src={`${base}images/about/isabella-kohout.jpg`} alt="Portrait of Isabella Kohout" />
        </figure>
        <div class="about-copy">
          <div class="about-story">
            <p>I studied photography at die Graphische and Art Education at the University of Applied Arts Vienna. Along the way, I worked in film, architecture and editorial design, lived and worked in Austria and France, and eventually spent several years teaching art and design.</p>
            <p>Teaching changed the way I think about design. It made me interested in what happens after something looks good: whether people understand it, want to explore it, remember it, or feel invited to take part.</p>
            <p>Today, my work brings together graphic design, illustration, art, education, storytelling and digital interaction. I’m particularly interested in creating learning experiences that feel intuitive, visual and engaging — experiences people actually want to spend time with.</p>
          </div>
          <div class="about-salon">
            <h3>Salon Format</h3>
            <p class="about-salon-intro">Learning, visual communication and playful interaction come together in my independent practice.</p>
            <p>I develop interactive courses, digital experiences, museum and cultural projects, and visual learning materials for adults and young people.</p>
            <p>The projects can take very different forms, but they share the same approach: making ideas easier to explore and understand through thoughtful design, interaction and storytelling.</p>
            <p>Salon Format is also a space for experimentation — bringing together illustration, technology, sound, movement and whatever else helps an idea come to life.</p>
          </div>
        </div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <img src={`${base}brand/salon-format-mark.png`} alt="" />
        <div>
          <p class="section-label">Start a conversation</p>
          <h2 id="contact-title">Would you like to work together?</h2>
          <a class="contact-email" href="mailto:bellakohout@gmail.com">bellakohout@gmail.com</a>
        </div>
      </section>
    </main>
    <script>
      const scratch = document.querySelector('.scratch-reveal');
      const canvas = scratch?.querySelector('.scratch-canvas');
      if (scratch instanceof HTMLElement && canvas instanceof HTMLCanvasElement) {
        const context = canvas.getContext('2d');
        let drawing = false;

        const prepareCanvas = () => {
          const rect = scratch.getBoundingClientRect();
          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.round(rect.width * ratio);
          canvas.height = Math.round(rect.height * ratio);
          canvas.style.width = `${rect.width}px`;
          canvas.style.height = `${rect.height}px`;
          context?.setTransform(ratio, 0, 0, ratio, 0, 0);
          if (context) {
            context.globalCompositeOperation = 'source-over';
            context.fillStyle = '#2823e8';
            context.fillRect(0, 0, rect.width, rect.height);
          }
        };

        const scratchAt = (event) => {
          if (!context) return;
          const rect = canvas.getBoundingClientRect();
          context.globalCompositeOperation = 'destination-out';
          context.beginPath();
          context.arc(event.clientX - rect.left, event.clientY - rect.top, Math.max(28, rect.width * .07), 0, Math.PI * 2);
          context.fill();
          scratch.classList.add('is-started');
        };

        canvas.addEventListener('pointerdown', (event) => {
          drawing = true;
          canvas.setPointerCapture(event.pointerId);
          scratchAt(event);
        });
        canvas.addEventListener('pointermove', (event) => drawing && scratchAt(event));
        canvas.addEventListener('pointerup', () => { drawing = false; });
        canvas.addEventListener('pointercancel', () => { drawing = false; });
        scratch.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            scratch.classList.add('is-revealed', 'is-started');
          }
        });
        prepareCanvas();
        window.addEventListener('resize', prepareCanvas, { passive: true });
      }
    </script>
  </body>
</html>
