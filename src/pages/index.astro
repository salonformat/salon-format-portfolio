---
import '@fontsource/della-respira';
import '@fontsource/josefin-sans/400.css';
import '@fontsource/josefin-sans/500.css';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Salon Format — interactive learning experiences by Isabella Kohout." />
    <link rel="icon" type="image/png" href={`${base}brand/salon-format-mark.png`} />
    <title>Salon Format — Learning Experience Design</title>
  </head>
  <body>
    <!--
    THESIS: A learning portfolio that begins with a person, not a platform, and refuses the standard white project-grid hero.
    OWN-WORLD: Cobalt-blue studio field, flat modular color sections, Della Respira, Josefin Sans, and Isabella's illustration as the connective tissue.
    STORY: Meet Salon Format, see learner-centred work in action, understand Isabella's combined practice, then start a conversation.
    FIRST VIEWPORT: Wordmark and learner-first claim sit left; an abstract learning sequence connects colored forms on the right; the yellow featured project rises into the bottom edge as the primary onward action.
    FORM: Contemporary Learning Salon, grounded candidate 6, seed 229794fb.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <header class="site-header">
      <a class="mark-link" href="#top" aria-label="Salon Format home">
        <img src={`${base}brand/salon-format-mark.png`} alt="" />
      </a>
      <nav aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <img class="wordmark" src={`${base}brand/salon-format-wordmark-only.png`} alt="Salon Format" />
          <h1 id="hero-title">Learning experiences for real people.</h1>
        </div>
        <div class="learning-motion" aria-hidden="true">
          <svg viewBox="0 0 760 620" role="presentation">
            <path class="motion-shape motion-shape-one" d="M93 119C143 53 258 56 291 126C323 195 268 275 183 271C95 267 42 187 93 119Z" />
            <path class="motion-shape motion-shape-two" d="M443 81C523 45 622 91 636 174C649 253 572 301 497 267C424 233 367 116 443 81Z" />
            <path class="motion-shape motion-shape-three" d="M288 345C346 297 441 318 471 380C502 446 449 523 363 515C278 508 229 394 288 345Z" />
            <image class="motion-mark" href={`${base}brand/salon-format-mark.png`} x="312" y="218" width="138" height="138" />
            <text class="motion-title" x="380" y="520" text-anchor="middle">An idea</text>
            <text class="motion-subtitle" x="380" y="553" text-anchor="middle">takes shape.</text>
          </svg>
        </div>
        <a class="scroll-cue" href="#projects" aria-label="Continue to featured project">
          <span></span>
        </a>
      </section>

      <section class="kusama-project" id="projects" aria-labelledby="kusama-title">
        <div class="kusama-copy">
          <p class="section-label">Featured project · 01</p>
          <p class="project-status">Working prototype</p>
          <h2 id="kusama-title">Into<br /><em>the Infinite</em></h2>
          <p class="kusama-description">A small interactive homage to Yayoi Kusama, built around repetition, sound and personal response.</p>
          <p class="project-meta">Cultural learning · Interaction · Reflection</p>
          <div class="project-actions">
            <a class="text-link" href={`${base}projects/into-the-infinite`}>View case study <span aria-hidden="true">→</span></a>
            <a class="text-link" href="https://github.com/salonformat/museum-experience-kusama" target="_blank" rel="noreferrer">Open the experience <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="kusama-visual" aria-hidden="true">
          <span class="kusama-dot dot-one"></span>
          <span class="kusama-dot dot-two"></span>
          <span class="kusama-dot dot-three"></span>
          <img src={`${base}images/kusama/figure.png`} alt="" />
        </div>
      </section>

      <section class="emilie-project" aria-labelledby="emilie-title">
        <div class="emilie-copy">
          <p class="section-label">Project 02</p>
          <p class="project-status">Work in progress · Working prototype</p>
          <h2 id="emilie-title">Emilie Flöge:<br /><em>Movement Through Fabric</em></h2>
          <p class="emilie-description">A digital museum prototype about clothing, movement and Emilie Flöge’s work.</p>
          <p class="project-meta">Cultural learning · Interactive storytelling · Experience design</p>
          <div class="project-actions">
            <a class="text-link" href={`${base}projects/emilie-floege`}>View case study <span aria-hidden="true">→</span></a>
            <a class="text-link subtle-link" href="https://github.com/salonformat/emilie-bewegung-aus-stoff" target="_blank" rel="noreferrer">Experience the prototype <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="emilie-visual" aria-hidden="true">
          <span class="emilie-orbit"></span>
          <img src={`${base}images/emilie/figure.png`} alt="" />
          <p>How much space does your clothing allow?</p>
        </div>
      </section>

      <section class="featured" aria-labelledby="featured-title">
        <div class="featured-copy">
          <p class="section-label">Project 03</p>
          <h2 id="featured-title">Learning,<br />Differently</h2>
          <p class="featured-description">A short interactive course about designing for a learner’s real situation.</p>
          <p class="project-meta">Inclusive learning · Learner context · Accessibility</p>
          <div class="project-actions">
            <a class="text-link" href={`${base}projects/learning-differently`}>View case study <span aria-hidden="true">→</span></a>
            <a class="text-link" href="https://getlarge.github.io/learning-differently/" target="_blank" rel="noreferrer">Open the experience <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="featured-preview" id="project-preview">
          <img src={`${base}images/learning-differently-preview.png`} alt="Learning, Differently interface showing Anna's train journey" />
        </div>
      </section>

      <section class="practice" aria-labelledby="practice-title">
        <div class="practice-intro">
          <p class="section-label">What we do</p>
          <h2 id="practice-title">Learning, design<br />and interaction.</h2>
        </div>
        <div class="practice-grid">
          <article class="practice-item learning">
            <h3>Learning</h3>
            <p>Learning experiences shaped around people, context and access.</p>
          </article>
          <article class="practice-item design">
            <h3>Design</h3>
            <p>Visual systems and illustration that help explain and organise ideas.</p>
          </article>
          <article class="practice-item experience">
            <h3>Experience</h3>
            <p>Interaction that gives people something useful to try, notice or change.</p>
          </article>
        </div>
      </section>

      <section class="about" id="about" aria-labelledby="about-title">
        <div>
          <p class="section-label">About</p>
          <h2 id="about-title">Graphic designer.<br />Art teacher.<br />Learning Experience Designer.</h2>
        </div>
        <div class="about-copy">
          <p>I started in graphic design, then spent several years teaching art and design. Today I use both backgrounds in Learning Experience Design.</p>
          <p>Salon Format is the place where I develop interactive courses, museum experiences and visual learning materials.</p>
        </div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <img src={`${base}brand/salon-format-mark.png`} alt="" />
        <div>
          <p class="section-label">Start a conversation</p>
          <h2 id="contact-title">Would you like to work together?</h2>
          <p>Contact details coming soon.</p>
        </div>
      </section>
    </main>
    <script>
      const motion = document.querySelector('.learning-motion');
      if (motion) {
        const updateMotion = (active) => motion.toggleAttribute('data-paused', !active);
        const observer = new IntersectionObserver(([entry]) => updateMotion(entry.isIntersecting && !document.hidden), { threshold: 0.15 });
        observer.observe(motion);
        document.addEventListener('visibilitychange', () => updateMotion(!document.hidden));
      }
    </script>
  </body>
</html>
