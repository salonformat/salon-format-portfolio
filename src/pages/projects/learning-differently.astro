---
import '@fontsource/della-respira';
import '@fontsource/josefin-sans/400.css';
import '@fontsource/josefin-sans/500.css';
import '../../styles/global.css';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Learning, Differently — a Salon Format inclusive learning design case study." />
    <link rel="icon" type="image/png" href={`${base}brand/salon-format-mark.png`} />
    <title>Learning, Differently — Salon Format</title>
  </head>
  <body class="case-page learning-case">
    <header class="case-header">
      <a href={base} aria-label="Back to Salon Format"><img src={`${base}brand/salon-format-mark.png`} alt="" /></a>
      <a href={`${base}#projects`}>All projects</a>
    </header>

    <main>
      <section class="case-hero">
        <div class="case-hero-copy">
          <p class="project-status">Interactive learning experience</p>
          <h1>Learning,<br /><em>Differently</em></h1>
          <p class="case-deck">A short interactive course about inclusive learning design, seen through one learner’s daily life.</p>
          <div class="case-actions">
            <a class="case-button" href="https://getlarge.github.io/learning-differently/" target="_blank" rel="noreferrer">Open the experience <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="learning-case-preview">
          <img src={`${base}images/learning-differently-preview.png`} alt="Learning, Differently interface showing Anna's train journey" />
        </div>
      </section>

      <section class="case-intro">
        <p class="case-number">The learning problem</p>
        <h2>What changes when a lesson begins with the learner’s situation?</h2>
        <p>Anna balances work, parenting and an online course. She has twenty minutes on the train, prefers reading and sometimes needs more time to process new information. Her situation becomes the starting point for each design choice.</p>
      </section>

      <section class="case-process learning-process">
        <div class="process-heading">
          <p class="case-number">Learning journey</p>
          <h2>Meet.<br />Notice.<br />Redesign.</h2>
        </div>
        <ol class="journey-list">
          <li><span>Meet Anna</span><p>Start with one learner and a familiar situation.</p></li>
          <li><span>Read the context</span><p>Explore time, sound, format and pace as design constraints.</p></li>
          <li><span>Open more ways in</span><p>Connect the situation to inclusive learning and UDL principles.</p></li>
          <li><span>Apply the idea</span><p>Redesign one part of a real lesson, presentation or workshop.</p></li>
        </ol>
      </section>

      <section class="decision-section">
        <p class="case-number">Key design decisions</p>
        <div class="decision-grid">
          <article><h3>Context first</h3><p>Anna’s situation gives each design principle a practical reason.</p></article>
          <article><h3>Short interactions</h3><p>Cards, choices and short reflections keep the course manageable.</p></article>
          <article><h3>Visual communication</h3><p>Typography, colour and illustration help people find their way through the course.</p></article>
          <article><h3>Try it yourself</h3><p>The final activity asks participants to revise one part of their own learning material.</p></article>
        </div>
      </section>

      <section class="case-role">
        <p class="case-number">Role and contribution</p>
        <h2>Learning Experience Design · Concept · Writing · Illustration · Interaction Design · Visual Direction · Prototyping</h2>
        <p>The working version is complete and currently being refined. Feedback and evaluation will be documented as the project develops.</p>
      </section>

      <nav class="case-next" aria-label="Project navigation">
        <p>Next case study</p>
        <a href={`${base}projects/emilie-floege`}>Emilie Flöge: Movement Through Fabric <span aria-hidden="true">→</span></a>
      </nav>
    </main>
  </body>
</html>
